# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-05
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=

# Better Auth
BETTER_AUTH_SECRET=           # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base de données (Neon Postgres - neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (resend.com — créer un compte, vérifier un domaine, générer une API key)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=PokerBlog <noreply@votredomaine.fr>
