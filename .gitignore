# env files (can opt-in for committing if needed)
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
card.txt

# skills marketplace/generique installes localement (symlinks vers .agents/skills) -
# pas du contenu projet. Les skills PLO ci-dessous restent trackes.
.claude/skills/*
!.claude/skills/nextjs-app-router-i18n
!.claude/skills/sanity-cms-plo
!.claude/skills/better-auth-drizzle-neon
